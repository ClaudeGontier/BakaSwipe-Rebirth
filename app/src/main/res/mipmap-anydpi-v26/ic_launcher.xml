<?xml version="1.0" encoding="utf-8"?>
<!-- Icône adaptive (Android 8+) : sans elle, le launcher réduit l'icône legacy dans un cercle blanc.
     Le logo occupe les 72dp visibles sur les 108dp du calque (marge de 18dp = 1/6 de chaque côté). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/bg" />
    <foreground>
        <inset
            android:drawable="@drawable/logo"
            android:inset="16.667%" />
    </foreground>
</adaptive-icon>
